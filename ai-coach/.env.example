# Copy to .env on the server. Never commit the real .env.

# 1 = canned answers, no AWS calls (use until Bedrock access is set up).
COACH_FAKE=1

# Bedrock (us-east-1). The key belongs to an IAM user allowed only
# bedrock:InvokeModel* on Anthropic models.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
COACH_MODEL=anthropic.claude-opus-5
COACH_FALLBACK_MODEL=anthropic.claude-opus-4-8

# Where camera frames and machine modes are read from.
COACH_EDGE_ORIGIN=https://play.freeskillclaw.cc
COACH_MACHINES=machine-01,machine-02

# Limits (clamped in coach.py).
COACH_CACHE_SECONDS=8
COACH_RATE_PER_MINUTE=12
COACH_PORT=8090
